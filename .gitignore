.coverage
.coverage.*
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/
.mypy_cache/
.ruff_cache/
htmlcov/

# Egg-info from local installs (any location — guards against renamed-fork drift).
**/*.egg-info/

# Project-local virtualenvs (root .venv is shared)
.venv/

# Regenerable artifacts — script runs and smoke tests write here; never tracked.
output/

# Build output the vendored copies' own builds write into vendor/.
vendor/**/build/
